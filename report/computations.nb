Cell["Question 1", "Section"],

Cell[CellGroupData[{

Cell["Q1 iv(a)", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RecurrenceTable", "[", "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "k", "]"}], "==",
       RowBox[{
        RowBox[{"y", "[",
         RowBox[{"k", "-", "1"}], "]"}], "+", "1"}]}], ",",
      "\[IndentingNewLine]",
      RowBox[{
       RowBox[{"y", "[", "k", "]"}], "==",
       RowBox[{
        RowBox[{"z", "[",
         RowBox[{"k", "-", "1"}], "]"}], "+", "2"}]}], ",",
      "\[IndentingNewLine]",
      RowBox[{
       RowBox[{"z", "[", "k", "]"}], "==",
       RowBox[{"1.1", "*",
        RowBox[{"x", "[",
         RowBox[{"k", "-", "1"}], "]"}]}]}], ",", "\[IndentingNewLine]",
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", "\[IndentingNewLine]",

      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]",

      RowBox[{
       RowBox[{"z", "[", "0", "]"}], "==", "0"}]}], "\[IndentingNewLine]",
     "}"}], ",", "\[IndentingNewLine]",
    RowBox[{"{",
     RowBox[{
      RowBox[{"x", "[", "k", "]"}], ",",
      RowBox[{"y", "[", "k", "]"}], ",",
      RowBox[{"z", "[", "k", "]"}]}], "}"}], ",", "\[IndentingNewLine]",
    RowBox[{"{",
     RowBox[{"k", ",", "1", ",", "4"}], "}"}]}], "\[IndentingNewLine]", "]"}],
   "//", "MatrixForm"}]], "Input"]
}]]
}]],

Cell[CellGroupData[{

Cell["Q1 iv(b)", "Subsection"],

Cell["\<\
The stability of a system with an update matrix is determined by its \
characteristic polynomial.  The coefficients entered symbolically to prevent \
numerical errors.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"recurrentUM", "=",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"1.1", ",", "0", ",", "0"}], "}"}]}], "}"}], "//",
    "Rationalize"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{"%", "//", "MatrixForm"}]}], "Input"]
}]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"recurrentCP", "=",
  RowBox[{"CharacteristicPolynomial", "[",
   RowBox[{"recurrentUM", ",", "\[Lambda]"}], "]"}]}]], "Input"]
}]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[",
   RowBox[{
    RowBox[{"recurrentCP", "==", "0"}], ",", "\[Lambda]"}], "]"}], "//",
  "ComplexExpand"}]], "Input"]
}]]
}]]
}]],

